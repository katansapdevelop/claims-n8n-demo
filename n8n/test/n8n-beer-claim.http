
@host = http://localhost:5678/

@N8N_API_KEY = {{$dotenv N8N_API_KEY}}

@basic_auth = n8n_wf_user:n8n_wf_user

### Trigger Webhook using Basic Auth with one attachments
POST {{host}}webhook-test/submitClaimReview HTTP/1.1
Authorization: Basic {{basic_auth}}
Content-Type: application/json

{
  "ID": "3b241101-e2bb-4255-8caf-4136c566a981",
  "claim_id": "2000000003",
  "description": "Excessive sediment and haze in beer",
  "type": "Quality Claim",
  "primary_defect_code_name": "Appearance",
  "secondary_defects": [
    {
      "defect_code_name": "Discolouration"
    },
    {
      "defect_code_name": "Poor Carbonation"
    }
  ],
  "evidenceAttachments": [
    {
      "ID": "4b483a38-24aa-44fe-a570-71c2fcd0965d",
      "name": "ColaCanCrushed.jpeg",
      "contentType": "image/jpeg",
      "objectId": "85e0a9de-7168-442f-abba-04081bd327ea",
      "type_id": "DAMAGE",
      "type": "Evidence of Damage",
      "stream": ""
    }
  ],
  "impacted_pallets": [
    {
      "id": "1000000040",
      "beer_name": "Twofold WCIPA",
      "quantity": 10,
      "uom_id": "CT"
    }
  ]
}
    


### Trigger Webhook using Basic Auth with two attachments
POST {{host}}webhook-test/submitClaimReview HTTP/1.1
Authorization: Basic {{basic_auth}}
Content-Type: application/json


{
