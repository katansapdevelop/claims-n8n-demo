{
  "_version": "1.85.0",
  "sap.app": {
    "id": "com.logicalstarconsulting.claims",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.27.0",
      "toolsId": "5c98605f-9fed-4443-b3f8-10d8766fdf29"
    },
    "dataSources": {
      "mainService": {
        "uri": "/app/claim/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "claim-manage": {
          "semanticObject": "claim",
          "action": "manage",
          "icon": "sap-icon://customer-financial-fact-sheet",
          "title": "{{claim-manage.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.149.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.logicalstarconsulting.claims.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ClaimsList",
          "target": "ClaimsList"
        },
        {
          "pattern": "Claims({key}):?query:",
          "name": "ClaimsObjectPage",
          "target": "ClaimsObjectPage"
        }
      ],
      "targets": {
        "ClaimsList": {
          "type": "Component",
          "id": "ClaimsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Claims",
              "variantManagement": "Page",
              "navigation": {
                "Claims": {
                  "detail": {
                    "route": "ClaimsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "condensedTableLayout": false
                  },
                  "columns": {
                    "DataField::type_id": {
                      "width": "15rem"
                    }
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "ClaimsObjectPage": {
          "type": "Component",
          "id": "ClaimsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Claims",
              "controlConfiguration": {
                "attachments/@com.sap.vocabularies.UI.v1.LineItem#Attachment": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "disableCopyToClipboard": true,
                    "enableExport": false,
                    "personalization": {
                      "column": false,
                      "filter": false,
                      "group": false,
                      "sort": false
                    },
                    "enablePaste": false,
                    "selectionMode": "Single",
                    "selectAll": true
                  },
                  "columns": {
                    "FilePreview": {
                      "header": "Preview",
                      "position": {
                        "anchor": "DataField::content",
                        "placement": "After"
                      },
                      "template": "com.logicalstarconsulting.claims.ext.fragment.FilePreview",
                      "width": "10rem"
                    }
                  },
                  "actions": {
                    "DownloadEvidence": {
                      "press": "com.logicalstarconsulting.claims.ext.controller.ClaimsObjectPageActions.DownloadEvidence",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "Download"
                    },
                    "PreviewEvidence": {
                      "press": ".extension.com.logicalstarconsulting.claims.ext.controller.ClaimsObjectPageExtension.onPreviewEvidence",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "Preview",
                      "position": {
                        "placement": "Before",
                        "anchor": "DownloadEvidence"
                      }
                    }
                  }
                },
                "costs/@com.sap.vocabularies.UI.v1.LineItem#AdditionalCosts": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                },
                "pallets/@com.sap.vocabularies.UI.v1.LineItem#Pallets": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "content": {
                "footer": {
                  "actions": {
                    "RejectReview": {
                      "press": "com.logicalstarconsulting.claims.ext.controller.ClaimsObjectPageActions.onReviewerReject",
                      "visible": "{= %{status/id} === 2 }",
                      "enabled": true,
                      "text": "Reject Review",
                      "position": {
                        "placement": "After",
                        "anchor": "DataFieldForAction::ClaimAppService.submitReviewApprove"
                      }
                    }
                  }
                },
                "body": {
                  "sections": {
                    "AuditLogTimeLine": {
                      "template": "com.logicalstarconsulting.claims.ext.fragment.AuditLogTimeLine",
                      "position": {
                        "placement": "After",
                        "anchor": "AgentAssessment"
                      },
                      "title": "Audit Log"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController#com.logicalstarconsulting.claims::ClaimsObjectPage": {
            "controllerName": "com.logicalstarconsulting.claims.ext.controller.ClaimsObjectPageExtension"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
