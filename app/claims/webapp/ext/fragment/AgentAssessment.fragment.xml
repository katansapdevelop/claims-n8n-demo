<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns="sap.m" xmlns:macros="sap.fe.macros">
<VBox id="agentAssessmentVBox">
	<f:Form id="agentAssessmentForm">
		<f:layout>
			<f:ColumnLayout id="agentAssessmentColumnLayout" columnsM="1" columnsL="1" columnsXL="1" labelCellsLarge="1" />
		</f:layout>
		<f:formContainers>
			<f:FormContainer id="agentAssessmentFormContainerSummary">
				<f:formElements>
					<macros:FormElement metaPath="agent_approval_summary" id="formElementIdWithLabel" label="Summary">
						<TextArea id="agentAssessmentSummaryTextArea" value="{agent_approval_summary}" growing="true" editable="false" />
					</macros:FormElement>
				</f:formElements>
			</f:FormContainer>
			<f:FormContainer id="agentAssessmentFormContainerExplanation" expandable="true" title="Show More" expanded="false">
				<f:formElements>
					<macros:FormElement metaPath="agent_approval_explanation" id="formElementDescriptionWithLabel" label="Explanation" >
						<TextArea id="agentAssessmentExplanationTextArea" value="{agent_approval_explanation}" growing="true" editable="false" />
					</macros:FormElement>
				</f:formElements>
			</f:FormContainer>
		</f:formContainers>
	</f:Form>
	</VBox>
</core:FragmentDefinition>
